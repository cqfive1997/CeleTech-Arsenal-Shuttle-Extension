<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleCockpitSegmentDef>
    <defName>CT_Shuttle_CockpitSegment</defName>
    <label>Cockpit</label>
    <description>The shuttle command section for piloting, navigation, drive control, and landing control modules.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_ModularAirframe</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>320</Steel>
      <Plasteel>80</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>12000</constructionWorkTicks>
    <segmentTypeID>optional</segmentTypeID>
    <mass>35</mass>
    <installableSegmentSlotTypes>
      <li>cockpit</li>
    </installableSegmentSlotTypes>
    <installableModuleTypes>
      <li>cockpit</li>
      <li>navigation</li>
      <li>support</li>
    </installableModuleTypes>
    <moduleSlots>
      <li>
        <slotTypeID>cockpit</slotTypeID>
        <isRequired>true</isRequired>
        <labelKey>CT_Shuttle_ModuleSlot_Cockpit</labelKey>
        <shortLabelKey>CT_Shuttle_ModuleSlot_CockpitShort</shortLabelKey>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
    </moduleSlots>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleCockpitSegmentDef>

  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttlePowerSegmentDef>
    <defName>CT_Shuttle_PowerSegment</defName>
    <label>Power Bay</label>
    <description>The shuttle power section for reactors, battery storage, and onboard power regulation.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_InternalPowerBus</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>360</Steel>
      <Plasteel>100</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>14000</constructionWorkTicks>
    <segmentTypeID>power</segmentTypeID>
    <mass>40</mass>
    <installableSegmentSlotTypes>
      <li>power</li>
    </installableSegmentSlotTypes>
    <installableModuleTypes>
      <li>reactor</li>
      <li>battery</li>
      <li>power-regulator</li>
    </installableModuleTypes>
    <moduleSlots>
      <li>
        <slotTypeID>reactor</slotTypeID>
        <isRequired>true</isRequired>
        <labelKey>CT_Shuttle_ModuleSlot_Reactor</labelKey>
        <shortLabelKey>CT_Shuttle_ModuleSlot_ReactorShort</shortLabelKey>
      </li>
      <li>
        <slotTypeID>battery</slotTypeID>
        <isRequired>true</isRequired>
        <labelKey>CT_Shuttle_ModuleSlot_Battery</labelKey>
        <shortLabelKey>CT_Shuttle_ModuleSlot_BatteryShort</shortLabelKey>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
    </moduleSlots>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttlePowerSegmentDef>

  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleCargoSegmentDef>
    <defName>CT_Shuttle_CargoSegment</defName>
