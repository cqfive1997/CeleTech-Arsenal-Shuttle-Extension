    <constructionCostList>
      <Steel>380</Steel>
      <Plasteel>120</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>14000</constructionWorkTicks>
    <segmentTypeID>weapon</segmentTypeID>
    <mass>36</mass>
    <installableSegmentSlotTypes>
      <li>weapon</li>
    </installableSegmentSlotTypes>
    <installableModuleTypes>
      <li>shield</li>
      <li>weapon</li>
      <li>armor</li>
      <li>fire-control</li>
      <li>ammo-loader</li>
    </installableModuleTypes>
    <moduleSlots>
