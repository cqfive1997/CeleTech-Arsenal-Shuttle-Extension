      <li>
        <slotTypeID>armor</slotTypeID>
        <labelKey>CT_Shuttle_ModuleSlot_Shield</labelKey>
        <shortLabelKey>CT_Shuttle_ModuleSlot_ShieldShort</shortLabelKey>
