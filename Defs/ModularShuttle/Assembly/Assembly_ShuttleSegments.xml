      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
    </moduleSlots>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleCargoSegmentDef>

  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleSupportSegmentDef>
    <defName>CT_Shuttle_SupportSegment</defName>
    <label>Support Bay</label>
    <description>An optional shuttle support section for drive control, landing stabilization, scanners, logistics support, and mobile production modules.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_ModularAirframe</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>280</Steel>
      <Plasteel>50</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </constructionCostList>
    <constructionWorkTicks>10000</constructionWorkTicks>
    <segmentTypeID>support</segmentTypeID>
    <mass>30</mass>
    <installableSegmentSlotTypes>
      <li>support</li>
    </installableSegmentSlotTypes>
    <installableModuleTypes>
      <li>support</li>
      <li>scanner</li>
      <li>production</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">mech-charger</li>
    </installableModuleTypes>
    <moduleSlots>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
      <li>
        <slotTypeID>optional</slotTypeID>
      </li>
    </moduleSlots>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleSupportSegmentDef>

  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleSupportSegmentDef>
    <defName>CT_Shuttle_WeaponBaySegment</defName>
    <label>Weapon Bay</label>
    <description>An optional shuttle combat section for shields, point-defense, CIWS, rockets, hull plating, and fire-control radar modules.</description>
