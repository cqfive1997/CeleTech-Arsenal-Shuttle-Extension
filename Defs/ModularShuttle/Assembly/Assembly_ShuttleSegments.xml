      <li>CT_Shuttle_CargoBayEngineering</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>300</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </constructionCostList>
    <constructionWorkTicks>9000</constructionWorkTicks>
    <segmentTypeID>cargo</segmentTypeID>
    <mass>25</mass>
    <installableSegmentSlotTypes>
      <li>cargo</li>
    </installableSegmentSlotTypes>
    <installableModuleTypes>
      <li>cargo</li>
      <li>support</li>
      <li>production</li>
    </installableModuleTypes>
    <moduleSlots>
      <li>
        <slotTypeID>optional</slotTypeID>
