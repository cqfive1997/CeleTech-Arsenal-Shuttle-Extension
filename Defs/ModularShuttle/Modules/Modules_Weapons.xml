<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleWeaponModuleDef>
    <defName>CT_Shuttle_Module_6mmPointDefense</defName>
    <label>6mm point-defense module</label>
    <description>A light point-defense weapon module for engaging close threats and incoming targets.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_WeaponBayIntegration</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>220</Steel>
      <Plasteel>90</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>9000</constructionWorkTicks>
    <moduleTypeID>weapon</moduleTypeID>
    <mass>100</mass>
    <idlePowerDrawWatts>90</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>weapon</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>weapon</li>
    </installableModuleSlotTypes>
    <weaponRole>PointDefense</weaponRole>
    <weaponDef>CT_Shuttle_Weapon_6mmPointDefenseGun</weaponDef>
    <mountCount>1</mountCount>
    <muzzleCellOffsets>
      <li>(-1,0,1)</li>
    </muzzleCellOffsets>
    <firingPowerDrawWatts>1400</firingPowerDrawWatts>
    <scanIntervalTicks>2</scanIntervalTicks>
    <warmupTicks>1</warmupTicks>
    <cooldownTicks>3</cooldownTicks>
    <canAutoFire>true</canAutoFire>
    <canAutoFireWithoutFireControl>true</canAutoFireWithoutFireControl>
    <fallbackAutoFireRange>25</fallbackAutoFireRange>
    <canSetForcedTarget>true</canSetForcedTarget>
    <requiresScanner>false</requiresScanner>
    <requiresNavigationComputer>false</requiresNavigationComputer>
    <canInterceptProjectiles>true</canInterceptProjectiles>
    <pointDefenseExplosiveOrOverheadOnly>true</pointDefenseExplosiveOrOverheadOnly>
    <pointDefenseMaxIncomingSpeed>80</pointDefenseMaxIncomingSpeed>
    <pointDefenseProtectionRadius>8</pointDefenseProtectionRadius>
    <pointDefenseMaxAssignmentsPerThreat>2</pointDefenseMaxAssignmentsPerThreat>
    <pointDefenseAssignmentLeaseTicks>30</pointDefenseAssignmentLeaseTicks>
    <maxAmmo>0</maxAmmo>
    <modExtensions>
      <li Class="CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleWeaponModuleAmmoExtension">
        <ammoSet>CT_ShuttleAmmoSet_PointDefense</ammoSet>
        <magazineCapacity>1000</magazineCapacity>
        <ammoPerShot>12</ammoPerShot>
        <reloadWorkTicks>60</reloadWorkTicks>
        <autoReloadEnabledByDefault>true</autoReloadEnabledByDefault>
        <allowManualReload>true</allowManualReload>
        <allowUnload>false</allowUnload>
        <logisticsAutoFeedEligible>true</logisticsAutoFeedEligible>
        <reloadPowerDemandWatts>600</reloadPowerDemandWatts>
        <ammoMassCountsTowardCargo>1</ammoMassCountsTowardCargo>
      </li>
    </modExtensions>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleWeaponModuleDef>
