<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleReactorModuleDef>
    <defName>CT_Shuttle_CompactFissionReactorModule</defName>
    <label>compact fission reactor module</label>
    <description>A compact fission reactor module that provides baseline shuttle power generation and grid export.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_InternalPowerBus</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>250</Steel>
      <Plasteel>120</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
      <Uranium>30</Uranium>
    </constructionCostList>
    <constructionWorkTicks>12000</constructionWorkTicks>
    <moduleTypeID>reactor</moduleTypeID>
    <mass>250</mass>
    <idlePowerDrawWatts>0</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>power</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>reactor</li>
    </installableModuleSlotTypes>
    <reactorGenerationWatts>10000</reactorGenerationWatts>
    <gridExportCapacityWatts>10000</gridExportCapacityWatts>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleReactorModuleDef>
