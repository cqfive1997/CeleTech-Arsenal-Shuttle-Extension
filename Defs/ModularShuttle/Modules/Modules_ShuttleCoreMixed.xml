  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleCargoLogisticsModuleDef>
    <defName>CT_Shuttle_Module_CargoLogisticsCore</defName>
    <label>cargo logistics core</label>
    <description>Allows automation, food, medicine, ammunition, and production systems to withdraw from or deposit into cargo. It handles internal routing; it neither stores items nor increases payload capacity.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_CargoBayEngineering</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>250</Steel>
      <Plasteel>60</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>7000</constructionWorkTicks>
    <moduleTypeID>support</moduleTypeID>
    <mass>250</mass>
    <idlePowerDrawWatts>200</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>support</li>
      <li>cargo</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>support</li>
    </installableModuleSlotTypes>
    <enablesCargoResourceBroker>true</enablesCargoResourceBroker>
    <supportsItemTransfer>true</supportsItemTransfer>
