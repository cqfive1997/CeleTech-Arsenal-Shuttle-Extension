  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleLandingStabilizerModuleDef>
    <defName>CT_Shuttle_LandingStabilizerModule</defName>
    <label>landing stabilizer module</label>
    <description>Stabilizes shuttle launch and landing control so adverse weather can be bypassed within configured limits.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_LandingStabilization</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>220</Steel>
      <Plasteel>80</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>7000</constructionWorkTicks>
