<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleCockpitModuleDef>
    <defName>CT_Shuttle_CockpitModule</defName>
    <label>pilot station module</label>
    <description>Provides the crew control station required for shuttle command and basic crew capacity.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_ModularAirframe</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>220</Steel>
      <Plasteel>80</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>8000</constructionWorkTicks>
    <moduleTypeID>cockpit</moduleTypeID>
    <mass>120</mass>
    <idlePowerDrawWatts>250</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>cockpit</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>cockpit</li>
    </installableModuleSlotTypes>
    <providesCockpit>true</providesCockpit>
    <additionalCrewCapacity>3</additionalCrewCapacity>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleCockpitModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleNavigationComputerModuleDef>
    <defName>CT_Shuttle_NavigationComputerModule</defName>
    <label>navigation computer module</label>
    <description>Extends shuttle navigation range and reduces launch recovery time through improved flight computation.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_FlightControlMatrix</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>120</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>7000</constructionWorkTicks>
    <moduleTypeID>navigation</moduleTypeID>
    <mass>60</mass>
    <idlePowerDrawWatts>250</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>cockpit</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>navigation</li>
    </installableModuleSlotTypes>
    <rangeBonusTiles>20</rangeBonusTiles>
    <launchCooldownFactor>0.8</launchCooldownFactor>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleNavigationComputerModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleNavigationComputerModuleDef>
    <defName>CT_Shuttle_AdvancedNavigationComputerModule</defName>
    <label>advanced navigation computer module</label>
    <description>A high-end navigation computer designed for long-range autonomous flight. It extends flight range, eliminates the wait before the shuttle can launch again, and uses built-in electronic countermeasures to break through signal blockades. With it installed, the shuttle can launch autonomously without a colonist pilot aboard, even when no colonist remains on an expedition map. The tradeoff is greater mass, expensive components, and high continuous power consumption.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_FlightControlMatrix</li>
      <li>CT_Shuttle_ZeroPointPower</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>180</Steel>
      <Plasteel>180</Plasteel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>8</ComponentSpacer>
      <Uranium>60</Uranium>
      <Gold>40</Gold>
    </constructionCostList>
    <constructionWorkTicks>15000</constructionWorkTicks>
    <moduleTypeID>navigation</moduleTypeID>
    <mass>120</mass>
    <idlePowerDrawWatts>1200</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>cockpit</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>navigation</li>
    </installableModuleSlotTypes>
    <rangeBonusTiles>35</rangeBonusTiles>
    <launchCooldownFactor>0</launchCooldownFactor>
    <providesAutonomousLaunchControl>true</providesAutonomousLaunchControl>
    <providesSecureSignalLink>true</providesSecureSignalLink>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleNavigationComputerModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleDriveControlModuleDef>
    <defName>CT_Shuttle_DriveControlModule</defName>
