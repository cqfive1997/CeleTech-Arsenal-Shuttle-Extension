  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleCargoModuleDef>
    <defName>CT_Shuttle_CargoLatchModule</defName>
    <label>cargo locker</label>
    <description>Adds a cargo region with its own filter for organizing loaded items and routing them through the cargo logistics core. It does not increase the shuttle's overall payload limit.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_CargoBayEngineering</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>120</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
