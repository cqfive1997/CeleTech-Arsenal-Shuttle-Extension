<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
    <defName>CT_Shuttle_Habitat_I</defName>
    <label>single-berth habitat module I</label>
    <description>An entry-level low-capacity shuttle habitat module. One occupant gets generous personal space, so comfort per person is high.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_HabitatSupport</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>120</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </constructionCostList>
    <constructionWorkTicks>5000</constructionWorkTicks>
    <moduleTypeID>habitat</moduleTypeID>
    <mass>80</mass>
    <idlePowerDrawWatts>180</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>cockpit</li>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>habitat</li>
    </installableModuleSlotTypes>
    <habitatSleepSlots>1</habitatSleepSlots>
    <habitatDiningSlots>1</habitatDiningSlots>
    <habitatSupportsSleep>true</habitatSupportsSleep>
    <habitatSupportsDining>true</habitatSupportsDining>
    <habitatSleepThoughtStageIndex>7</habitatSleepThoughtStageIndex>
    <habitatDiningThoughtStageIndex>7</habitatDiningThoughtStageIndex>
    <habitatRestEffectiveness>1.2</habitatRestEffectiveness>
    <suppressSleepDisturbedThoughts>true</suppressSleepDisturbedThoughts>
    <suppressBarracksThoughts>true</suppressBarracksThoughts>
    <allowInventoryFood>true</allowInventoryFood>
    <allowCargoFoodWithdrawal>false</allowCargoFoodWithdrawal>
    <requireCargoLogisticsForFoodWithdrawal>true</requireCargoLogisticsForFoodWithdrawal>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
    <defName>CT_Shuttle_Habitat_II</defName>
    <label>dual-berth habitat module II</label>
    <description>A two-occupant shuttle habitat module that balances personal space, comfort support, and automated meal access.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_HabitatSupport</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>160</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </constructionCostList>
    <constructionWorkTicks>6500</constructionWorkTicks>
    <moduleTypeID>habitat</moduleTypeID>
    <mass>120</mass>
    <idlePowerDrawWatts>280</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>cockpit</li>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>habitat</li>
    </installableModuleSlotTypes>
    <habitatSleepSlots>2</habitatSleepSlots>
    <habitatDiningSlots>2</habitatDiningSlots>
    <habitatSupportsSleep>true</habitatSupportsSleep>
    <habitatSupportsDining>true</habitatSupportsDining>
    <habitatSleepThoughtStageIndex>5</habitatSleepThoughtStageIndex>
    <habitatDiningThoughtStageIndex>5</habitatDiningThoughtStageIndex>
    <habitatRestEffectiveness>1.1</habitatRestEffectiveness>
    <suppressSleepDisturbedThoughts>true</suppressSleepDisturbedThoughts>
    <suppressBarracksThoughts>true</suppressBarracksThoughts>
    <allowInventoryFood>true</allowInventoryFood>
    <allowCargoFoodWithdrawal>true</allowCargoFoodWithdrawal>
    <requireCargoLogisticsForFoodWithdrawal>true</requireCargoLogisticsForFoodWithdrawal>
    <preferredAutoFoodDefs>
      <li>MealFine</li>
      <li>MealSimple</li>
      <li>MealSurvivalPack</li>
    </preferredAutoFoodDefs>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
    <defName>CT_Shuttle_Habitat_III</defName>
    <label>triple-berth habitat module III</label>
    <description>An advanced three-occupant shuttle habitat module that trades some per-person comfort for higher onboard capacity.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_HabitatSupport</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>220</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </constructionCostList>
    <constructionWorkTicks>8000</constructionWorkTicks>
    <moduleTypeID>habitat</moduleTypeID>
    <mass>180</mass>
    <idlePowerDrawWatts>420</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>cockpit</li>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>habitat</li>
    </installableModuleSlotTypes>
    <habitatSleepSlots>3</habitatSleepSlots>
    <habitatDiningSlots>3</habitatDiningSlots>
    <habitatSupportsSleep>true</habitatSupportsSleep>
    <habitatSupportsDining>true</habitatSupportsDining>
    <habitatSleepThoughtStageIndex>4</habitatSleepThoughtStageIndex>
    <habitatDiningThoughtStageIndex>4</habitatDiningThoughtStageIndex>
    <habitatRestEffectiveness>1.05</habitatRestEffectiveness>
    <suppressSleepDisturbedThoughts>true</suppressSleepDisturbedThoughts>
    <suppressBarracksThoughts>true</suppressBarracksThoughts>
    <allowInventoryFood>true</allowInventoryFood>
    <allowCargoFoodWithdrawal>true</allowCargoFoodWithdrawal>
    <requireCargoLogisticsForFoodWithdrawal>true</requireCargoLogisticsForFoodWithdrawal>
    <preferredAutoFoodDefs>
      <li>MealLavish</li>
      <li>MealFine</li>
      <li>MealSimple</li>
      <li>MealSurvivalPack</li>
    </preferredAutoFoodDefs>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
    <defName>CT_Shuttle_Habitat_IV</defName>
    <label>four-berth habitat module IV</label>
    <description>A four-occupant shuttle habitat module that maximizes onboard capacity while still providing basic rest and meal support for each occupant.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_HabitatSupport</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>280</Steel>
      <Plasteel>80</Plasteel>
      <ComponentIndustrial>7</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>10000</constructionWorkTicks>
    <moduleTypeID>habitat</moduleTypeID>
    <mass>260</mass>
    <idlePowerDrawWatts>650</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>cockpit</li>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>habitat</li>
    </installableModuleSlotTypes>
    <habitatSleepSlots>4</habitatSleepSlots>
    <habitatDiningSlots>4</habitatDiningSlots>
    <habitatSupportsSleep>true</habitatSupportsSleep>
    <habitatSupportsDining>true</habitatSupportsDining>
    <habitatSleepThoughtStageIndex>3</habitatSleepThoughtStageIndex>
    <habitatDiningThoughtStageIndex>3</habitatDiningThoughtStageIndex>
    <habitatRestEffectiveness>1</habitatRestEffectiveness>
    <suppressSleepDisturbedThoughts>true</suppressSleepDisturbedThoughts>
    <suppressBarracksThoughts>true</suppressBarracksThoughts>
    <allowInventoryFood>true</allowInventoryFood>
    <allowCargoFoodWithdrawal>true</allowCargoFoodWithdrawal>
    <requireCargoLogisticsForFoodWithdrawal>true</requireCargoLogisticsForFoodWithdrawal>
    <preferredAutoFoodDefs>
      <li>MealLavish</li>
      <li>MealFine</li>
      <li>MealSurvivalPack</li>
    </preferredAutoFoodDefs>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
</Defs>
