<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleAutoWorkTableModuleDef>
    <defName>CT_Shuttle_AutoWorkTableModule</defName>
    <label>auto worktable module</label>
    <description>Provides automated shuttle production using supported workbench recipes and cargo logistics.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_MobileFabricationBay</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>160</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>8000</constructionWorkTicks>
    <moduleTypeID>production</moduleTypeID>
    <mass>300</mass>
    <idlePowerDrawWatts>250</idlePowerDrawWatts>
    <moduleComplexityCost>2</moduleComplexityCost>
    <installableSegmentTypes>
      <li>support</li>
      <li>cargo</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>optional</li>
    </installableModuleSlotTypes>
    <sourceBenchDefs>
      <li>TableMachining</li>
      <li>FabricationBench</li>
    </sourceBenchDefs>
    <allowAutoPickFirstCraftableRecipe>false</allowAutoPickFirstCraftableRecipe>
    <requiresCargoLogistics>true</requiresCargoLogistics>
    <requirePoweredInternalBus>true</requirePoweredInternalBus>
    <allowSurgeryRecipes>false</allowSurgeryRecipes>
    <allowMechanitorOnlyRecipes>false</allowMechanitorOnlyRecipes>
    <allowGestationRecipes>false</allowGestationRecipes>
    <allowMechResurrectionRecipes>false</allowMechResurrectionRecipes>
    <allowFormingTickRecipes>false</allowFormingTickRecipes>
    <allowUnfinishedThingRecipes>false</allowUnfinishedThingRecipes>
    <allowSpecialProductRecipes>false</allowSpecialProductRecipes>
    <allowCustomRecipeWorkers>false</allowCustomRecipeWorkers>
    <allowQualityProducts>false</allowQualityProducts>
    <allowNonItemProducts>false</allowNonItemProducts>
    <allowPawnProducts>false</allowPawnProducts>
    <allowBuildingProducts>false</allowBuildingProducts>
    <allowStuffProducts>false</allowStuffProducts>
    <workAmountFactor>1</workAmountFactor>
    <workSpeedFactor>1</workSpeedFactor>
    <activePowerDrawWatts>1000</activePowerDrawWatts>
    <workTickIntervalTicks>60</workTickIntervalTicks>
    <recipeCheckIntervalTicks>250</recipeCheckIntervalTicks>
    <depositRetryIntervalTicks>250</depositRetryIntervalTicks>
    <maxCatchUpTicks>2500</maxCatchUpTicks>
    <virtualSkillLevels>
      <li>
        <skill>Crafting</skill>
        <level>20</level>
      </li>
    </virtualSkillLevels>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleAutoWorkTableModuleDef>

