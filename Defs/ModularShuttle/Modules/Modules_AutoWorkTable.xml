    <constructionCostList>
      <Steel>160</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </constructionCostList>
    <constructionWorkTicks>7000</constructionWorkTicks>
    <moduleTypeID>production</moduleTypeID>
    <mass>220</mass>
    <idlePowerDrawWatts>180</idlePowerDrawWatts>
    <moduleComplexityCost>2</moduleComplexityCost>
    <installableSegmentTypes>
      <li>support</li>
      <li>cargo</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>optional</li>
    </installableModuleSlotTypes>
    <sourceBenchDefs>
      <li>ElectricStove</li>
      <li>TableButcher</li>
