<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMedicalBayModuleDef>
    <defName>CT_Shuttle_MedicalBay_I</defName>
    <label>Medical Bay Module I</label>
    <description>A compact shuttle medical bay for medevac triage, patient containment, and limited passive comfort. It does not provide treatment or stabilization.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_MedicalEvacuationBay</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>160</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </constructionCostList>
    <constructionWorkTicks>7000</constructionWorkTicks>
    <moduleTypeID>medical-bay</moduleTypeID>
    <mass>100</mass>
    <idlePowerDrawWatts>300</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>medical-bay</li>
    </installableModuleSlotTypes>
    <medicalPatientSlots>1</medicalPatientSlots>
    <supportsMedevacPriority>true</supportsMedevacPriority>
    <supportsStabilization>false</supportsStabilization>
    <supportsPassiveComfort>true</supportsPassiveComfort>
    <passiveJoyGainFactor>0.75</passiveJoyGainFactor>
    <passiveJoyCapPct>0.5</passiveJoyCapPct>
    <comfortThoughtStageIndex>0</comfortThoughtStageIndex>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMedicalBayModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMedicalBayModuleDef>
    <defName>CT_Shuttle_MedicalBay_II</defName>
    <label>Medical Bay Module II</label>
    <description>An improved shuttle medical bay with two patient positions and stronger passive comfort support. It still requires doctors for actual treatment.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_MedicalEvacuationBay</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>220</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>9000</constructionWorkTicks>
    <moduleTypeID>medical-bay</moduleTypeID>
    <mass>160</mass>
    <idlePowerDrawWatts>450</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>medical-bay</li>
    </installableModuleSlotTypes>
    <medicalPatientSlots>2</medicalPatientSlots>
    <supportsMedevacPriority>true</supportsMedevacPriority>
    <supportsStabilization>false</supportsStabilization>
    <supportsPassiveComfort>true</supportsPassiveComfort>
    <passiveJoyGainFactor>0.9</passiveJoyGainFactor>
    <passiveJoyCapPct>0.6</passiveJoyCapPct>
    <comfortThoughtStageIndex>1</comfortThoughtStageIndex>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMedicalBayModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMedicalBayModuleDef>
    <defName>CT_Shuttle_MedicalBay_III</defName>
    <label>Medical Bay Module III</label>
    <description>An advanced shuttle medical bay with three patient positions and impressive passive comfort support. It monitors patients but does not replace doctor care.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_MedicalEvacuationBay</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>300</Steel>
      <Plasteel>80</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>12000</constructionWorkTicks>
    <moduleTypeID>medical-bay</moduleTypeID>
    <mass>240</mass>
    <idlePowerDrawWatts>650</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>medical-bay</li>
    </installableModuleSlotTypes>
    <medicalPatientSlots>3</medicalPatientSlots>
    <supportsMedevacPriority>true</supportsMedevacPriority>
    <supportsStabilization>false</supportsStabilization>
    <supportsPassiveComfort>true</supportsPassiveComfort>
    <passiveJoyGainFactor>1.05</passiveJoyGainFactor>
    <passiveJoyCapPct>0.7</passiveJoyCapPct>
    <comfortThoughtStageIndex>2</comfortThoughtStageIndex>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMedicalBayModuleDef>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMedicalBayModuleDef>
    <defName>CT_Shuttle_MedicalBay_IV</defName>
    <label>Medical Bay Module IV</label>
    <description>A high-end shuttle medical bay with four patient positions and excellent passive comfort support for longer evacuations.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_MedicalEvacuationBay</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>420</Steel>
      <Plasteel>140</Plasteel>
      <ComponentIndustrial>14</ComponentIndustrial>
      <ComponentSpacer>4</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>16000</constructionWorkTicks>
    <moduleTypeID>medical-bay</moduleTypeID>
    <mass>340</mass>
    <idlePowerDrawWatts>900</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>medical-bay</li>
    </installableModuleSlotTypes>
    <medicalPatientSlots>4</medicalPatientSlots>
    <supportsMedevacPriority>true</supportsMedevacPriority>
    <supportsStabilization>false</supportsStabilization>
    <supportsPassiveComfort>true</supportsPassiveComfort>
    <passiveJoyGainFactor>1.2</passiveJoyGainFactor>
    <passiveJoyCapPct>0.8</passiveJoyCapPct>
    <comfortThoughtStageIndex>3</comfortThoughtStageIndex>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMedicalBayModuleDef>
</Defs>
