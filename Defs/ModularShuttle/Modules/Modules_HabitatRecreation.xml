<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
    <defName>CT_Shuttle_RecreationRoom_Decent</defName>
    <label>Recreation Module I</label>
    <description>A compact shuttle recreation module with enough media and games to keep passengers from getting stuck in one kind of fun.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_HabitatSupport</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>100</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </constructionCostList>
    <constructionWorkTicks>5000</constructionWorkTicks>
    <moduleTypeID>habitat</moduleTypeID>
    <mass>80</mass>
    <idlePowerDrawWatts>220</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>cockpit</li>
      <li>support</li>
      <li>living</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>habitat</li>
    </installableModuleSlotTypes>
    <habitatSupportsSleep>false</habitatSupportsSleep>
    <habitatSupportsDining>false</habitatSupportsDining>
    <allowInventoryFood>false</allowInventoryFood>
    <allowCargoFoodWithdrawal>false</allowCargoFoodWithdrawal>
    <habitatSupportsJoy>true</habitatSupportsJoy>
    <habitatJoySlots>1</habitatJoySlots>
    <habitatJoyKindCapacity>5</habitatJoyKindCapacity>
    <habitatJoyGainFactor>1.00</habitatJoyGainFactor>
    <habitatJoyThoughtStageIndex>0</habitatJoyThoughtStageIndex>
    <allowedJoyKinds>
      <li>CT_Joy_ShortVideo</li>
      <li>CT_Joy_MicroDrama</li>
      <li>CT_Joy_DramaVariety</li>
      <li>CT_Joy_DanmakuVideo</li>
      <li>CT_Joy_LiveStream</li>
      <li>CT_Joy_MobileGame</li>
      <li>CT_Joy_ChessCards</li>
      <li>CT_Joy_Karaoke</li>
      <li>CT_Joy_Music</li>
      <li>CT_Joy_WebNovel</li>
      <li>CT_Joy_TeaChat</li>
      <li>CT_Joy_DanceFitness</li>
    </allowedJoyKinds>
    <defaultJoyKinds>
      <li>CT_Joy_ShortVideo</li>
      <li>CT_Joy_MobileGame</li>
      <li>CT_Joy_ChessCards</li>
      <li>CT_Joy_Music</li>
      <li>CT_Joy_WebNovel</li>
    </defaultJoyKinds>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleHabitatModuleDef>
