<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMechChargerModuleDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>CT_Shuttle_MechCharger_I</defName>
    <label>mech charging bay module I</label>
    <description>A compact shuttle bay that can hold and recharge up to four colony mechanoids without producing toxic waste.</description>
    <researchPrerequisites>
      <li>CT_Shuttle_MechLogisticsInterface</li>
    </researchPrerequisites>
    <constructionCostList>
      <Steel>160</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </constructionCostList>
    <constructionWorkTicks>8000</constructionWorkTicks>
    <moduleTypeID>mech-charger</moduleTypeID>
    <mass>120</mass>
    <idlePowerDrawWatts>320</idlePowerDrawWatts>
    <installableSegmentTypes>
      <li>support</li>
    </installableSegmentTypes>
    <installableModuleSlotTypes>
      <li>mech-charger</li>
    </installableModuleSlotTypes>
    <mechChargeSlots>4</mechChargeSlots>
    <chargeRateFactor>1.0</chargeRateFactor>
  </CeleTech.ShuttleExtension.ModularShuttle.Defs.ShuttleMechChargerModuleDef>
